# Yerel geliştirme varsayılanları. Kopyalayıp local/.env olarak kullanın.
# Paylaşılan bir makinede POSTGRES_PASSWORD değiştirin.
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar

# Compose'un host'a açtığı portlar:
API_PORT=3001
WEB_PORT=5173

# Host üzerinde çalıştırılan API için (Compose bu URL'yi kullanmaz):
# POSTGRES_PASSWORD değişirse URL'deki parolayı da güncelleyin.
DATABASE_URL=postgres://radar:radar@127.0.0.1:5432/radar
REDIS_URL=redis://127.0.0.1:6379
PORT=3001
HOST=127.0.0.1

# Anahtarlı hızlı giriş. En az 16 karakter; boşsa /ingest kapalıdır.
INGEST_TOKEN=

# Yerel API'nin ntfy SSE kaynağı. NTFY_TOPIC boşsa bağlantı kurulmaz.
NTFY_TOPIC=
# ntfy yükündeki key ile eşleşmesi gereken anahtar; boşsa filtre uygulanmaz.
NTFY_KEY=
# NTFY_BASE_URL=https://ntfy.sh
# NTFY_RECONNECT_MS=5000

# Host üzerinde, local/collector dizininden çalıştırılan scanner köprüsü için:
SCANNER_DATA_DIR=../../site/firsat/data
RADAR_API_URL=http://127.0.0.1:3001
# POLL_MS=5000
# MAX_AGE_MS=900000
# BATCH_SIZE=50
