# Panel erişim anahtarı (boş bırakılırsa API herkese açık olur)
PANEL_PASSWORD=degistir-beni

# API'ye erişebilecek origin'ler (virgülle). GitHub Pages adresiniz:
PANEL_ORIGINS=https://cehennemgibiyim.github.io

# Aynı anda dinlenecek yayın sayısı
RADAR_MAX_TARGETS=40

# Zarf/mektup jetonunun geçerlilik süresi (saniye)
RADAR_LETTER_TTL=180

# HTTPS profili için alan adı (docker compose --profile https)
DOMAIN=
